# Better Auth — oturum imzalama anahtarı. Üretmek için: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Better Auth client'ın SSR sırasında sunucu kendi API'sine istek atabilmesi için
# gereken taban URL (prod'da gerçek domain, dev'de genelde http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000

# NuxtHub self-hosting (prod). Lokal geliştirmede gerekmez — NuxtHub .data/ altında
# otomatik bir SQLite/KV proxy'si kullanır 
NUXT_HUB_PROJECT_KEY=

# Resend — borç/ödeme bildirim e-postaları için. resend.com'dan alınır.
# Boş bırakılırsa e-posta gönderilmez (sessizce atlanır), uygulama çalışmaya devam eder.
RESEND_API_KEY=

# Resend'in test göndericisi

RESEND_FROM_EMAIL=
